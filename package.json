{
  "name": "dajem-group",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "workspaces": [
    "apps/landing",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace landing",
    "dev": "npm run dev --workspace landing",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "npm run lint --workspace landing",
    "deploy:check": "npm run build"
  }
}
