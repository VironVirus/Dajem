# Shared platform
DAJEM_SESSION_SECRET=change-this-session-secret
DAJEM_ADMIN_EMAIL=
DAJEM_ADMIN_PASSWORD=
DAJEM_ADMIN_PHONE=
# Optional first-run fallback; delivery admin can update this later.
DAJEM_SUPPORT_WHATSAPP=
NEXT_PUBLIC_DAJEM_SITE_URL=https://your-domain.com
NEXT_PUBLIC_DAJEM_REFRESH_INTERVAL_MS=0

# Supabase linkage: shared database, documents, and processed media
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dajem-documents
SUPABASE_MEDIA_BUCKET=dajem-media

# Optional Flutterwave linkage
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Test-only payment switch. Keep false on the public production site.
DAJEM_ALLOW_MOCK_PAYMENTS=false

# Optional DHL Express live survey-plan rates
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_API_MODE=test
DHL_ORIGIN_CITY=Enugu
DHL_ORIGIN_POSTAL_CODE=400001

# Optional Cloudflare security
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
